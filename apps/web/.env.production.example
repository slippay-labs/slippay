# Production-only env template for the web app.
# Copy to .env.production or inject these environment variables during CI/CD deploy.
# Never commit the populated .env.production file to the repository.

# API Base URL (same-origin /api routes through Hono/Deno reverse-proxy)
VITE_API_BASE=https://app.slippay.cc/api

# Stellar network selection (PUBLIC for mainnet)
VITE_STELLAR_NETWORK=PUBLIC

# Platform fee-collection account (mainnet). Receives platform share of checkouts.
VITE_PLATFORM_ADDRESS=G...

# Subscription contract (autocharge + attestation gate + platform fee)
VITE_SUB_CONTRACT=C...

# Supabase production instance URL and public anon key
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Transak on-ramp public widget key and environment
VITE_TRANSAK_API_KEY=your-transak-api-key
VITE_TRANSAK_ENV=production

# Feature flags & Treasury
VITE_COMEX_ENABLED=1

# Privy App ID for embedded wallet & email auth (safe in client bundle)
VITE_PRIVY_APP_ID=your-privy-app-id
VITE_BASE_NETWORK=mainnet

# 4P off-ramp receiver address pin (Base network)
VITE_4P_OFFRAMP_RECEIVER=0x...
