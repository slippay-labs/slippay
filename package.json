{
  "name": "slippay",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node api.js && pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "api:test": "deno test --allow-all supabase/functions/api/test/",
    "check:schema": "node scripts/check-schema-alignment.mjs",
    "policy-checkout:spike": "NODE_PATH=apps/web/node_modules node scripts/policy-checkout-spike-server.mjs",
    "eval:prove": "node eval/prove_vs_judge_benchmark.mjs",
    "eval:prove:test": "node --test eval/prove_vs_judge_benchmark.test.mjs",
    "eval:governance": "python -m pip install -r eval/requirements.txt && python eval/agent_governance_eval.py",
    "eval:test": "pnpm run eval:prove:test && python -m pip install -r eval/requirements.txt && python -m pytest eval/test_agent_governance_eval.py"
  },
  "devDependencies": {
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "globals": "^15.14.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "@solana-program/token>@solana/kit": "5.5.1"
    }
  }
}
